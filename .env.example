# ==============================================================================
# Game Platform - Environment Configuration Template
# ==============================================================================
#
# THIS FILE IS COMMITTED TO VERSION CONTROL. IT MUST CONTAIN PLACEHOLDERS ONLY.
# Never paste a real key here. Copy this file to .env.local and fill that in.
#
#   cp .env.example apps/web/.env.local
#
# Variable classes:
#   [PUBLIC]  NEXT_PUBLIC_* -> compiled into the browser bundle. Assume public.
#   [SERVER]  Next.js server-side only. Never prefix these with NEXT_PUBLIC_.
#   [SECRET]  Cloudflare Worker secrets. Set via `wrangler secret put`,
#             NOT in this file and NOT in .env.local. See docs/ENVIRONMENT_SETUP.md
#
# Full walkthrough (where to click, what to copy): docs/ENVIRONMENT_SETUP.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WEB APPLICATION
# ------------------------------------------------------------------------------
# [PUBLIC] Base URL the web app is served from.
NEXT_PUBLIC_APP_URL=http://localhost:8000

# [PUBLIC] Realtime Worker WebSocket origin.
#   local dev  -> ws://localhost:8787
#   production -> wss://<worker-name>.<subdomain>.workers.dev
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:8787

# ------------------------------------------------------------------------------
# 2. SUPABASE  (Database + Auth)      Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
# [PUBLIC] Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# [PUBLIC] The "anon" / "publishable" key. Safe in the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# [SERVER] The "service_role" / "secret" key. BYPASSES ROW LEVEL SECURITY.
# Never expose to the browser. Never commit. Rotate immediately if leaked.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# [PUBLIC] Project ref only (the subdomain above). Used to build the JWKS URL
# the realtime Worker uses to verify access tokens.
NEXT_PUBLIC_SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE  (Workers + Durable Objects)   Only needed to DEPLOY.
# ------------------------------------------------------------------------------
# [SERVER] Dashboard > Workers & Pages > right sidebar "Account ID"
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# [SERVER] My Profile > API Tokens > Create Token > "Edit Cloudflare Workers"
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH
# ------------------------------------------------------------------------------
# NOTE: There is deliberately no GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET here.
# Google credentials are entered into the Supabase dashboard
# (Authentication > Providers > Google), never into this application.
# See docs/ENVIRONMENT_SETUP.md step 2.

# ------------------------------------------------------------------------------
# 5. DEFERRED - not required until the phase noted. Leave as-is for now.
# ------------------------------------------------------------------------------
# LiveKit voice (Phase 14, spec section 26)
# [PUBLIC]
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
# [SERVER]
LIVEKIT_API_KEY=your-livekit-api-key
# [SERVER]
LIVEKIT_API_SECRET=your-livekit-api-secret

# Observability (spec sections 24, 99)
# [PUBLIC]
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# [PUBLIC]
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
# [PUBLIC]
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# 6. RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
